# PURE LIFE OS - Configurazione Produzione
# Copia questo file come .env e compila i valori

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=purelife_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=purelife_os

# JWT Authentication
JWT_SECRET=generate-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# FiveM SSO - Rotazione chiavi (entrambe accettate per 24h)
FIVEM_SECRET_CURRENT=your-fivem-secret-current
FIVEM_SECRET_PREVIOUS=your-fivem-secret-previous

# CORS
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
